# Required. Voyage AI text embeddings (voyage-3-lite)
VOYAGE_API_KEY=

# Required. Anthropic API; the agent runs on claude-haiku-5-5
ANTHROPIC_API_KEY=

# Required. Supabase project holding the financial_tools catalogue
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Port to listen on; Railway sets this automatically (default 3000)
# PORT=3000

# Optional, local evaluation only. Overrides the agent model (default claude-haiku-5-5)
# AGENT_MODEL=claude-sonnet-5-5

# Optional, local evaluation only. 1 adds per-run token counts to /recommend responses.
# Never set this in production.
# EVAL_INCLUDE_USAGE=1
