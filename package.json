{
  "name": "dascet-ai-engine",
  "version": "0.1.0",
  "description": "AI recommendation engine for Dascet — learning project covering embeddings, RAG, and agentic workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint . --write",
    "lint:check": "biome lint .",
    "lint:fix": "biome check . --write",
    "fix:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "staged": "biome check --write --staged",
    "type-check": "npm run typecheck",
    "experiment": "tsx",
    "test:phase1-2": "tsx scripts/test-phase1-2.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:all": "npm run test:phase1-2 && npm test",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p experiments/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.49.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "voyageai": "^0.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0"
  }
}
